#include <iostream>
using namespace std;

int main() {
    int age;
    string userID, password;
    float amount, discount;
    cout << "Enter your age: ";
    cin >> age;

    if (age < 13)
        cout << "You are a Child." << endl;
    else if (age >= 13 && age <= 19)
        cout << "You are a Teenager." << endl;
    else
        cout << "You are an Adult." << endl;

    cout << "\nEnter User ID: ";
    cin >> userID;
    cout << "Enter Password: ";
    cin >> password;

    if (userID == "admin" && password == "1234")
        cout << "Access Granted!" << endl;
    else
        cout << "Access Denied!" << endl;

    cout << "\nEnter shopping amount: $";
    cin >> amount;

    if (amount < 50)
        discount = 0;
    else if (amount >= 50 && amount < 100)
        discount = 10;
    else if (amount >= 100 && amount < 200)
        discount = 20;
    else
        discount = 25;

    cout << "You get a " << discount << "% discount." << endl;

    return 0;
}
