#include <iostream>
using namespace std;
void leftrotate(int arr[],int n, int k){
	int temp[100];
	for(int i=0;i<k;i++){
		temp[i]=arr[i];
	}
	for(int i=0;i<n-k;i++){
		arr[i]=arr[i+k];
	}
	for(int i=0; i<k;i++){
		arr[n-k+i]=temp[i];
	}
}
int main(){
	cout<<"array[1 2 3 4 5]"<<endl;
	int arr[5]={1,2,3,4,5};
	int k=2;
	int n=5;
	
leftrotate(arr,n,k);
for(int i=0;i<n;i++){
	cout<<arr[i]<<" ";
}

return 0;
}
